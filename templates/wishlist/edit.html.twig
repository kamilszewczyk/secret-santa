{% extends 'base.html.twig' %}

{% block title %}Moja lista życzeń{% endblock %}

{% block body %}
    <h1>Cześć {{ name }}! To Twoja lista życzeń</h1>
    <p class="hint">Każdy pomysł wpisz w nowej linii. Linki (https://…) będą klikalne dla Twojego Mikołaja.</p>

    {% for message in app.flashes('success') %}
        <p class="flash">{{ message }}</p>
    {% endfor %}

    {{ form_start(form, {attr: {class: 'wishlist-form'}}) }}
    {{ form_errors(form) }}
    {{ form_widget(form.wishlist) }}
    {{ form_widget(form.save) }}
    {{ form_end(form) }}

    <p class="hint"><a href="{{ path('app_wishlist', {name: name}) }}">Zobacz, jak widzą ją inni →</a></p>
{% endblock %}
