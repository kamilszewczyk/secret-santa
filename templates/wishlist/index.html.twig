{% extends 'base.html.twig' %}

{% block title %}Lista życzeń – {{ name }}{% endblock %}

{% block body %}
    <h1>Lista życzeń: {{ name }}</h1>

    {% if wishlist|trim is not empty %}
        <div class="wishlist">{{ wishlist|wishlist }}</div>
    {% else %}
        <p class="hint">{{ name }} nie dodał(a) jeszcze nic do swojej listy. Zajrzyj tu później!</p>
    {% endif %}
{% endblock %}
